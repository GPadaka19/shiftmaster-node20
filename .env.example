# Salin ke .env.local untuk development. Jangan commit nilai asli.

# Postgres (development: database lokal di EnvKit)
DATABASE_URL=postgres://postgres@localhost:5432/shiftmaster_dev

# Login admin: OAuth client tipe "Web application" (lihat docs/google-sheets-credentials.md bagian B)
GOOGLE_CLIENT_ID=

# Superadmin pertama, dibuat oleh `pnpm db:seed` kalau belum ada
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_NICKNAME=

# Jalankan migrasi database saat server start (dipakai di container produksi)
RUN_MIGRATIONS=false

# Google Sheets (lihat docs/google-sheets-credentials.md bagian A)
# Jadwal kuliah; dari range hanya nama sheet yang dipakai
SOURCE_SPREADSHEET_ID=
SOURCE_READ_RANGE=JADWAL!A1:Z200
# Agenda lab
M_SOURCE_SPREADSHEET_ID=
M_SOURCE_READ_RANGE=AgendaLab!A1:Z200
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REFRESH_TOKEN=

# --- Dipakai mulai Fase 2 ---
# CRON_SECRET=
